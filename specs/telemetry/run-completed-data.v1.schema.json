{
	"$id": "https://side-quest.dev/schemas/l30d/run-completed-data.v1.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "L30D Run Completed Data v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contract_version",
		"run_id",
		"topic",
		"query_type",
		"strategy",
		"depth",
		"days",
		"range",
		"started_at",
		"completed_at",
		"duration_ms",
		"status",
		"sources_requested",
		"sources_executed",
		"phase2",
		"counts",
		"latency",
		"cost",
		"top_trends",
		"data_quality",
		"confidence"
	],
	"properties": {
		"contract_version": { "const": "l30d.run.completed.v1" },
		"run_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
		"topic": { "type": "string", "minLength": 1, "maxLength": 500 },
		"query_type": {
			"type": "string",
			"enum": ["PROMPTING", "RECOMMENDATIONS", "NEWS", "GENERAL"]
		},
		"strategy": { "type": "string", "enum": ["single", "two-phase"] },
		"depth": { "type": "string", "enum": ["quick", "default", "deep"] },
		"days": { "type": "integer", "minimum": 1, "maximum": 365 },
		"range": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to"],
			"properties": {
				"from": { "type": "string", "format": "date" },
				"to": { "type": "string", "format": "date" }
			}
		},
		"started_at": { "type": "string", "format": "date-time" },
		"completed_at": { "type": "string", "format": "date-time" },
		"duration_ms": { "type": "integer", "minimum": 0 },
		"status": { "type": "string", "enum": ["success", "partial_success"] },
		"sources_requested": {
			"type": "array",
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/source" }
		},
		"sources_executed": {
			"type": "array",
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/source" }
		},
		"sources_skipped": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["source", "reason_code"],
				"properties": {
					"source": { "$ref": "#/$defs/source" },
					"reason_code": {
						"type": "string",
						"enum": [
							"not_configured",
							"disabled_by_flag",
							"quick_mode_skip",
							"rate_limited",
							"budget_exceeded",
							"tool_unavailable",
							"timeout"
						]
					},
					"message": { "type": "string", "maxLength": 300 }
				}
			}
		},
		"phase2": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"executed",
				"budget_total",
				"budget_used",
				"skipped_reason"
			],
			"properties": {
				"enabled": { "type": "boolean" },
				"executed": { "type": "boolean" },
				"budget_total": { "type": "integer", "minimum": 0 },
				"budget_used": { "type": "integer", "minimum": 0 },
				"skipped_reason": {
					"oneOf": [
						{
							"type": "string",
							"enum": [
								"disabled",
								"quick_mode_default",
								"no_entities",
								"rate_limited",
								"stale_fallback_active",
								"budget_exceeded"
							]
						},
						{ "type": "null" }
					]
				}
			}
		},
		"counts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["raw_candidates_total", "final_total", "by_source"],
			"properties": {
				"raw_candidates_total": { "type": "integer", "minimum": 0 },
				"final_total": { "type": "integer", "minimum": 0 },
				"by_source": {
					"type": "object",
					"additionalProperties": false,
					"required": ["reddit", "x", "youtube", "web"],
					"properties": {
						"reddit": { "type": "integer", "minimum": 0 },
						"x": { "type": "integer", "minimum": 0 },
						"youtube": { "type": "integer", "minimum": 0 },
						"web": { "type": "integer", "minimum": 0 }
					}
				}
			}
		},
		"latency": {
			"type": "object",
			"additionalProperties": false,
			"required": ["phase1_ms", "phase2_ms", "scoring_ms", "total_ms"],
			"properties": {
				"phase1_ms": { "type": "integer", "minimum": 0 },
				"phase2_ms": { "type": "integer", "minimum": 0 },
				"scoring_ms": { "type": "integer", "minimum": 0 },
				"total_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"cost": {
			"type": "object",
			"additionalProperties": false,
			"required": ["estimated_total_usd", "by_provider"],
			"properties": {
				"estimated_total_usd": { "type": "number", "minimum": 0 },
				"by_provider": {
					"type": "object",
					"additionalProperties": false,
					"required": ["openai", "xai", "youtube", "web"],
					"properties": {
						"openai": { "type": "number", "minimum": 0 },
						"xai": { "type": "number", "minimum": 0 },
						"youtube": { "type": "number", "minimum": 0 },
						"web": { "type": "number", "minimum": 0 }
					}
				}
			}
		},
		"top_trends": {
			"type": "array",
			"minItems": 0,
			"maxItems": 20,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"trend_id",
					"entity",
					"category",
					"rank",
					"score",
					"source_count",
					"sources",
					"evidence_urls",
					"confidence"
				],
				"properties": {
					"trend_id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9._:-]{3,128}$"
					},
					"entity": { "type": "string", "minLength": 1, "maxLength": 200 },
					"category": {
						"type": "string",
						"enum": [
							"product",
							"company",
							"person",
							"technology",
							"framework",
							"topic",
							"other"
						]
					},
					"rank": { "type": "integer", "minimum": 1 },
					"score": { "type": "number", "minimum": 0, "maximum": 100 },
					"delta_score": { "type": "number", "minimum": -100, "maximum": 100 },
					"source_count": { "type": "integer", "minimum": 1, "maximum": 4 },
					"sources": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "$ref": "#/$defs/source" }
					},
					"evidence_urls": {
						"type": "array",
						"minItems": 1,
						"maxItems": 5,
						"items": { "type": "string", "format": "uri" }
					},
					"summary": { "type": "string", "maxLength": 300 },
					"confidence": {
						"$ref": "./confidence.v1.schema.json"
					}
				}
			}
		},
		"data_quality": {
			"$ref": "./data-quality.v1.schema.json"
		},
		"confidence": {
			"$ref": "./confidence.v1.schema.json"
		},
		"warnings": {
			"type": "array",
			"items": { "type": "string", "maxLength": 200 }
		},
		"extensions": { "type": "object", "additionalProperties": true }
	},
	"$defs": {
		"source": { "type": "string", "enum": ["reddit", "x", "youtube", "web"] }
	}
}
